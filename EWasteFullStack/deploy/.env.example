# Copy to ../.env (next to docker-compose.yml). Never commit the real file.
EWASTE_DOMAIN=ewaste.example.com
# Used only the FIRST time the database is created. Change it again inside the app (Profile tab) afterwards.
EWASTE_ADMIN_PASSWORD=change-me-to-a-long-random-password

# Optional email notifications
EWASTE_MAIL_ENABLED=false
EWASTE_MAIL_HOST=smtp.example.com
EWASTE_MAIL_PORT=587
EWASTE_MAIL_SECURITY=STARTTLS
EWASTE_MAIL_USERNAME=
EWASTE_MAIL_PASSWORD=
EWASTE_MAIL_FROM=
